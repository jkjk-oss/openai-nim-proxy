# ═══════════════════════════════════════════════════════════════════════════════
# NIM Proxy Configuration (.env file)
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED VARIABLES (MUST SET THESE)
# ────────────────────��─────────────────────────────────────────────────────────

# Your NVIDIA NIM API Key (get from https://build.nvidia.com/)
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client authentication token (used by clients to authenticate with this proxy)
# Generate a secure random string. Example: openssl rand -hex 32
CLIENT_AUTH_KEY=your-secret-auth-token-here-min-32-chars-recommended

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL VARIABLES (WITH DEFAULTS)
# ──────────────────────────────────────────────────────────────────────────────

# Port the proxy listens on (default: 3000)
PORT=3000

# NVIDIA NIM API Base URL (default: https://integrate.api.nvidia.com/v1)
# NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Enable reasoning display in responses (default: false)
# Set to 'true' to enable reasoning/thinking output
SHOW_REASONING=false

# Enable thinking mode for supported models (default: false)
# Set to 'true' to enable advanced reasoning for models like GLM-5.2, DeepSeek, etc.
ENABLE_THINKING_MODE=false

# Skip model validation at startup (default: false)
# Set to 'true' if your NIM provider doesn't support the /v1/models endpoint
SKIP_VALIDATION=false

# Discord webhook URL for model validation alerts (optional)
# When validation fails, alerts will be sent to this Discord channel
# Format: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
